# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Model binaries — personal-print-only licenses = do NOT redistribute via git.
# Track structure + MODELS.md manifest, not the files themselves.
raws/**/*.stl
raws/**/*.STL
raws/**/*.3mf
raws/**/*.obj
raws/**/*.step
raws/**/*.stp
raws/**/*.zip

# Sliced output — big, machine-specific, regenerable from Studio.
sliced/**/*.gcode
sliced/**/*.gcode.3mf
sliced/**/*.3mf

# BUT keep folder structure + anything we explicitly own
!**/.gitkeep
!owned/**
node_modules/
